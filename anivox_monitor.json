        ["🔮 Прогноз", "🔎 Поиск аниме", "🎭 Друзья"],
        ["⚙️ Настройки", "🔕 Уведомления", "☁️ GitHub Бэкап"],
        ["💬 Связать всех в чат", "🚪 Завершить чат"],
