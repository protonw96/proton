DEFAULT_INTERVAL = 10
DEFAULT_USER_AGENT = f"Mozilla/5.0 (Linux; Android 10; Mobile) AppleWebKit/537.36 Chrome/124.0 AniVoxMonitor/{VERSION}"
SHIKIMORI_UA = f"AniVoxMonitor/{VERSION} (https://anivox.fun)"

logger = logging.getLogger(APP_NAME)

